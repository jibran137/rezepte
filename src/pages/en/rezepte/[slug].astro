---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Ornament from '../../../components/Ornament.astro';
import { t, localizedPath } from '../../../i18n/ui';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const lang = 'en' as const;
const { recipe } = Astro.props;
const { Content } = await recipe.render();
const data = recipe.data;
const title = data.title_en ?? data.title;
const summary = data.summary_en ?? data.summary;
---

<Layout title={`${title} — rezepte`} description={summary} lang={lang}>
  <div class="container">
    <article class="recipe-detail-page">
      <a href={localizedPath(lang, '/')} class="back-link">Back to the collection</a>

      <header class="recipe-hero">
        <p class="eyebrow">{data.tags[0] ?? 'Recipe'}</p>
        <h1>{title}</h1>
        {summary && <p class="summary">{summary}</p>}
      </header>

      <Ornament />

      <section class="recipe-stats">
        {data.servings && (
          <div class="stat">
            <span class="stat-label">{t(lang, 'recipe.servings')}</span>
            <span class="stat-value">{data.servings}</span>
          </div>
        )}
        {data.time_minutes && (
          <div class="stat">
            <span class="stat-label">{t(lang, 'recipe.time')}</span>
            <span class="stat-value">{data.time_minutes}<span class="unit">{t(lang, 'recipe.minutes')}</span></span>
          </div>
        )}
        <div class="stat">
          <span class="stat-label">{t(lang, 'recipe.by')}</span>
          <span class="stat-author">
            {data.author}
            {data.city && <small>{data.city}</small>}
          </span>
        </div>
      </section>

      <section class="ingredients-section">
        <h2 class="ingredients-heading">{t(lang, 'recipe.ingredients')}</h2>
        <p class="ingredients-subhead">what you'll need</p>
        <ol class="ingredients-list">
          {data.ingredients.map((ing) => (
            <li>
              <span class="item">{ing.item_en ?? ing.item}</span>
              {ing.amount && <span class="amount">{ing.amount}</span>}
            </li>
          ))}
        </ol>

        {data.tags.length > 0 && (
          <div class="tags">
            {data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </section>

      <div class="recipe-body">
        <Content />
      </div>
    </article>
  </div>
</Layout>
