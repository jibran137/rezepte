---
interface Props {
  size?: number;
  spinning?: boolean;
  class?: string;
}

const { size = 24, spinning = false, class: className = '' } = Astro.props;
const classes = ['sun', spinning ? 'sun--spinning' : '', className].filter(Boolean).join(' ');
---

<svg
  class={classes}
  viewBox="-12 -12 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  aria-hidden="true"
>
  <line x1="0" y1="-10" x2="0" y2="-5.5" />
  <line x1="0" y1="5.5" x2="0" y2="10" />
  <line x1="-10" y1="0" x2="-5.5" y2="0" />
  <line x1="5.5" y1="0" x2="10" y2="0" />
  <line x1="-7.07" y1="-7.07" x2="-3.9" y2="-3.9" />
  <line x1="3.9" y1="3.9" x2="7.07" y2="7.07" />
  <line x1="-7.07" y1="7.07" x2="-3.9" y2="3.9" />
  <line x1="3.9" y1="-3.9" x2="7.07" y2="-7.07" />
  <circle cx="0" cy="0" r="2.4" />
</svg>
