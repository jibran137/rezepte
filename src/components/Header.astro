---
import Sun from './Sun.astro';
import ThemeToggle from './ThemeToggle.astro';
import { type Lang, t, localizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const homeHref = localizedPath(lang, '/');
const deHref = localizedPath('de', '/');
const enHref = localizedPath('en', '/');
---

<header class="site-header">
  <div class="container">
    <a href={homeHref} class="brand">
      <Sun size={22} spinning={true} />
      <span><em>rezepte</em></span>
    </a>

    <div class="header-actions">
      <nav class="lang-toggle" aria-label="Language">
        <a href={enHref} class={lang === 'en' ? 'active' : ''}>EN</a>
        <span class="sep">·</span>
        <a href={deHref} class={lang === 'de' ? 'active' : ''}>DE</a>
      </nav>
      <ThemeToggle label={t(lang, 'theme.toggle')} />
    </div>
  </div>
</header>
