---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={['ornament', className].filter(Boolean).join(' ')}
  viewBox="0 0 200 28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  aria-hidden="true"
>
  <line x1="2" y1="14" x2="78" y2="14" />
  <line x1="122" y1="14" x2="198" y2="14" />
  <g transform="translate(100 14)" stroke-width="1.3">
    <line x1="0" y1="-9" x2="0" y2="-4.5" />
    <line x1="0" y1="4.5" x2="0" y2="9" />
    <line x1="-9" y1="0" x2="-4.5" y2="0" />
    <line x1="4.5" y1="0" x2="9" y2="0" />
    <line x1="-6.4" y1="-6.4" x2="-3.2" y2="-3.2" />
    <line x1="3.2" y1="3.2" x2="6.4" y2="6.4" />
    <line x1="-6.4" y1="6.4" x2="-3.2" y2="3.2" />
    <line x1="3.2" y1="-3.2" x2="6.4" y2="-6.4" />
    <circle cx="0" cy="0" r="2.2" />
  </g>
</svg>
