---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Ornament from './Ornament.astro';
import { type Lang, t, localizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
  recipe: CollectionEntry<'recipes'>;
}

const { lang, recipe } = Astro.props;
const { Content } = await recipe.render();
const data = recipe.data;
const title = lang === 'en' && data.title_en ? data.title_en : data.title;
const summary = lang === 'en' && data.summary_en ? data.summary_en : data.summary;
---

<Layout title={`${title} — rezepte`} description={summary} lang={lang}>
  <div class="container">
    <article class="recipe-detail-page">
      <a href={localizedPath(lang, '/')} class="back-link">{t(lang, 'recipe.back')}</a>

      <header class="recipe-hero">
        <p class="eyebrow">{data.tags[0] ?? t(lang, 'recipe.fallbackTag')}</p>
        <h1>{title}</h1>
        {summary && <p class="summary">{summary}</p>}
      </header>

      <Ornament />

      <section class="recipe-stats">
        {data.servings && (
          <div class="stat">
            <span class="stat-label">{t(lang, 'recipe.servings')}</span>
            <span class="stat-value">{data.servings}</span>
          </div>
        )}
        {data.time_minutes && (
          <div class="stat">
            <span class="stat-label">{t(lang, 'recipe.time')}</span>
            <span class="stat-value">{data.time_minutes}<span class="unit">{t(lang, 'recipe.minutes')}</span></span>
          </div>
        )}
        <div class="stat">
          <span class="stat-label">{t(lang, 'recipe.by')}</span>
          <span class="stat-author">
            {data.author}
            {data.city && <small>{data.city}</small>}
          </span>
        </div>
      </section>

      <section class="ingredients-section">
        <h2 class="ingredients-heading">{t(lang, 'recipe.ingredients')}</h2>
        <p class="ingredients-subhead">{t(lang, 'recipe.ingredients.subhead')}</p>
        <ol class="ingredients-list">
          {data.ingredients.map((ing) => (
            <li>
              <span class="item">{lang === 'en' && ing.item_en ? ing.item_en : ing.item}</span>
              {ing.amount && <span class="amount">{ing.amount}</span>}
            </li>
          ))}
        </ol>

        {data.tags.length > 0 && (
          <div class="tags">
            {data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </section>

      <div class="recipe-body">
        <Content />
      </div>
    </article>
  </div>
</Layout>
