---
import Sun from './Sun.astro';
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <span class="footer-mark">
      <Sun size={18} />
      <em>rezepte</em>
    </span>
    <span>{t(lang, 'footer.opensource')}</span>
    <a href="https://github.com/jibran137/rezepte" target="_blank" rel="noopener">
      {t(lang, 'footer.contribute')} →
    </a>
  </div>
</footer>
