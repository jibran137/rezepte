---
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <span>{t(lang, 'footer.opensource')}</span>
    <a href="https://github.com/" target="_blank" rel="noopener">
      {t(lang, 'footer.contribute')} →
    </a>
  </div>
</footer>
