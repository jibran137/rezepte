---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RecipeCard from './RecipeCard.astro';
import Sun from './Sun.astro';
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const recipes = (await getCollection('recipes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const totalLabel = String(recipes.length).padStart(2, '0');
---

<Layout
  title={t(lang, 'meta.home.title')}
  description={t(lang, 'site.tagline')}
  lang={lang}
>
  <div class="container">
    <section class="hero">
      <Sun size={110} spinning={true} class="hero-mark" />
      <p class="hero-eyebrow">{t(lang, 'hero.eyebrow')}</p>
      <h1>
        {t(lang, 'hero.title.before')}<br />
        <span class="underline-swoop">{t(lang, 'hero.title.swoop')}</span>
        <em class="swash">{t(lang, 'hero.title.swash')}</em>
      </h1>
      <p class="lede">{t(lang, 'site.intro')}</p>
    </section>

    <section>
      <header class="section-title">
        <span>{t(lang, 'section.allRecipes')}</span>
        <span class="count">{totalLabel}</span>
      </header>
      <ol class="recipe-list">
        {recipes.map((recipe, i) => (
          <RecipeCard recipe={recipe} lang={lang} index={i + 1} />
        ))}
      </ol>
    </section>
  </div>
</Layout>
